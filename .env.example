# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key

# .NET API backend (migration target). Set per-module to "api" to route that
# feature to the ASP.NET Core API; anything else (or unset) keeps Supabase.
NEXT_PUBLIC_API_URL=https://api.f1controlroomdocs.com/chat-app
NEXT_PUBLIC_SIGNALR_URL=https://api.f1controlroomdocs.com/chat-app/hubs/chat
NEXT_PUBLIC_DATA_SOURCE_MESSAGING=supabase
NEXT_PUBLIC_DATA_SOURCE_FRIENDS=supabase
NEXT_PUBLIC_DATA_SOURCE_FRIEND_REQUESTS=supabase
NEXT_PUBLIC_DATA_SOURCE_PROFILE=supabase
NEXT_PUBLIC_DATA_SOURCE_STORIES=supabase
